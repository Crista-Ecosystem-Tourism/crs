POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=crs_agent

JWT_SECRET=change-me-jwt-secret-min-32-symbols

VECTORIZATION_URL=http://vectorization:8001
DATA_SEED_DIR=/app/data/seed

# Авто-bootstrap при старте, если БД пуста. По умолчанию ON: после деплоя
# контейнер сам наполнит БД. Если данные уже есть — повторный старт пропускает шаг.
DATA_AUTO_BOOTSTRAP=true

# Cron — раз в неделю, пн 00:01 UTC: полный прогон источников, затем сразу переиндексация Chroma
DATA_WEEKLY_CRON=1 0 * * 1
DATA_DISABLE_CRON=false

# Опциональный «короткий» admin-токен (без JWT) для запуска bootstrap из cron-скриптов
DATA_ADMIN_TOKEN=

CORS_ORIGINS=https://crista.online,https://www.crista.online,https://api.crista.online,http://localhost:3333,http://localhost:5173

# Локалка: ограничить OSM по субъектам (ISO3166-2 через запятую). Пусто = все из ru_regions.json.
# DATA_RU_REGION_ISO_FILTER=RU-MOW,RU-SPE,RU-KDA
# Не качать cities.json при пустом scope (только выбранные регионы РФ).
# DATA_SKIP_WORLD_CITIES=false
# Пропуск mkrf и kudago в полном ETL.
# DATA_SKIP_MKRF_KUDAGO=false
