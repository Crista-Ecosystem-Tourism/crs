# API ключ OpenRouter (https://openrouter.ai/)
OPENROUTER_API_KEY=

# JWT_SECRET для шифрования токенов (минимум 32 символа) — `openssl rand -hex 32`
JWT_SECRET=

# Пароль PostgreSQL (используется и postgres, и ai_agent при подключении)
POSTGRES_PASSWORD=postgres123

# Frontend URLs (вшиваются при сборке)
VITE_API_URL=https://api.crista.online
VITE_GRAPH_API_URL=https://graph.crista.online

# CORS — домены через запятую
CORS_ORIGINS=https://crista.online,https://www.crista.online
