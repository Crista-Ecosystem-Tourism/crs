# API ключ OpenRouter (https://openrouter.ai/)
OPENROUTER_API_KEY=

# JWT_SECRET — `openssl rand -hex 32`
JWT_SECRET=

# Пароль PostgreSQL
POSTGRES_PASSWORD=

# pgAdmin — :5050 с dev-оверлеем; email без .local (pgAdmin 8.14+), напр. admin@example.com
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# Привязка портов Docker: 127.0.0.1 — только с этой машины; 0.0.0.0 — для VPS/Coolify
COMPOSE_LAN_BIND=

# Build-time переменные фронта (Vite).
# По умолчанию прод ходит через тот же origin: /api -> ai_agent, /graph-api -> placesweb.
# Это убирает CORS между crista.online и api.crista.online.
#
# Локалка: VITE_API_URL=http://localhost:8002 ; VITE_GRAPH_API_URL=http://localhost:3333/graph-api
# Прод: VITE_API_URL=/api ; VITE_GRAPH_API_URL=/graph-api
VITE_API_URL=/api
VITE_GRAPH_API_URL=/graph-api

# Origin фронта для CORSMiddleware у ai_agent (через запятую, без пробелов).
# В прод обязательно прописать домен фронта, иначе браузер режет API.
CORS_ORIGINS=https://crista.online,https://www.crista.online,https://api.crista.online
