# API ключ OpenRouter (https://openrouter.ai/)
OPENROUTER_API_KEY=

# JWT_SECRET — `openssl rand -hex 32`
JWT_SECRET=

# Пароль PostgreSQL
POSTGRES_PASSWORD=

# pgAdmin — :5050 с dev-оверлеем; email без .local (pgAdmin 8.14+), напр. admin@example.com
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# Привязка портов Docker: 127.0.0.1 — только с этой машины; 0.0.0.0 — для VPS/Coolify
COMPOSE_LAN_BIND=

# Build-time переменные фронта (Vite). В Coolify ставь как Buildtime, иначе в js-бандле
# останутся localhost-ы. После смены — пересобрать фронт без кэша.
#
# Локалка: VITE_API_URL=http://localhost:8002 ; VITE_GRAPH_API_URL=http://localhost:3333/graph-api
# Прод: ниже сабдомены crista.online (placesweb отдаёт CORS=*, поэтому graph-сабдомен идёт напрямую)
VITE_API_URL=https://api.crista.online
VITE_GRAPH_API_URL=https://graph.crista.online

# Origin фронта для CORSMiddleware у ai_agent (через запятую, без пробелов).
# В прод обязательно прописать домен фронта, иначе браузер режет API.
CORS_ORIGINS=https://crista.online,https://www.crista.online
