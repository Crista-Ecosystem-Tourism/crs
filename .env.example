# API ключ OpenRouter (https://openrouter.ai/)
OPENROUTER_API_KEY=

# JWT_SECRET — `openssl rand -hex 32`
JWT_SECRET=

# Пароль PostgreSQL
POSTGRES_PASSWORD=

# pgAdmin — :5050 с dev-оверлеем; email без .local (pgAdmin 8.14+), напр. admin@example.com
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# Привязка портов Docker: 127.0.0.1 — только с этой машины; 0.0.0.0 — для VPS/Coolify
COMPOSE_LAN_BIND=

# Сборка фронта. Локалка: граф через тот же хост + /graph-api/
# Прод: VITE_GRAPH = https://<домен_фронта>/graph-api (нужен прокси в nginx как в crs/frontend/nginx.conf)
VITE_API_URL=
VITE_GRAPH_API_URL=

CORS_ORIGINS=
