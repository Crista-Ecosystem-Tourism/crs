{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Container CPU Usage",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0 },
        "overrides": []
      },
      "targets": [
        { "expr": "rate(container_cpu_usage_seconds_total{name=~\".+\", name!~\".*coolify.*|.*helper.*\"}[5m])", "legendFormat": "{{name}}", "refId": "A" }
      ]
    },
    {
      "title": "Container Memory Usage",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0 },
        "overrides": []
      },
      "targets": [
        { "expr": "container_memory_usage_bytes{name=~\".+\", name!~\".*coolify.*|.*helper.*\"}", "legendFormat": "{{name}}", "refId": "A" }
      ]
    },
    {
      "title": "Container Memory (Table)",
      "type": "table",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      },
      "targets": [
        { "expr": "sort_desc(container_memory_usage_bytes{name=~\".+\", name!~\".*coolify.*|.*helper.*\"})", "legendFormat": "{{name}}", "refId": "A", "instant": true, "format": "table" }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "id": true, "image": true, "instance": true, "job": true }, "renameByName": { "name": "Container", "Value": "Memory" } } }
      ]
    },
    {
      "title": "Container Network I/O",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "Bps" },
        "overrides": []
      },
      "targets": [
        { "expr": "rate(container_network_receive_bytes_total{name=~\".+\", name!~\".*coolify.*|.*helper.*\"}[5m])", "legendFormat": "↓ {{name}}", "refId": "A" },
        { "expr": "rate(container_network_transmit_bytes_total{name=~\".+\", name!~\".*coolify.*|.*helper.*\"}[5m])", "legendFormat": "↑ {{name}}", "refId": "B" }
      ]
    },
    {
      "title": "Container Restarts",
      "type": "stat",
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] } },
        "overrides": []
      },
      "targets": [
        { "expr": "changes(container_start_time_seconds{name=~\".+\", name!~\".*coolify.*|.*helper.*\"}[24h])", "legendFormat": "{{name}}", "refId": "A", "instant": true }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["crista", "docker"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "title": "🐳 Docker Containers",
  "uid": "crista-docker-containers"
}
