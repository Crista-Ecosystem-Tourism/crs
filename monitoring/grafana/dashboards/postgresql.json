{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Active Connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 80 }, { "color": "red", "value": 95 }] } },
        "overrides": []
      },
      "targets": [
        { "expr": "pg_stat_activity_count", "legendFormat": "Active", "refId": "A" },
        { "expr": "pg_settings_max_connections", "legendFormat": "Max", "refId": "B" }
      ]
    },
    {
      "title": "Cache Hit Ratio",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.9 }, { "color": "green", "value": 0.99 }] } },
        "overrides": []
      },
      "targets": [
        { "expr": "pg_stat_database_blks_hit{datname!=\"\"} / (pg_stat_database_blks_hit{datname!=\"\"} + pg_stat_database_blks_read{datname!=\"\"} + 0.001)", "legendFormat": "{{datname}}", "refId": "A", "instant": true }
      ]
    },
    {
      "title": "Database Size",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5368709120 }, { "color": "red", "value": 10737418240 }] } },
        "overrides": []
      },
      "targets": [
        { "expr": "pg_database_size_bytes{datname!=\"template0\", datname!=\"template1\"}", "legendFormat": "{{datname}}", "refId": "A", "instant": true }
      ]
    },
    {
      "title": "Transactions / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "min": 0 },
        "overrides": []
      },
      "targets": [
        { "expr": "rate(pg_stat_database_xact_commit{datname!=\"\"}[5m])", "legendFormat": "commit {{datname}}", "refId": "A" },
        { "expr": "rate(pg_stat_database_xact_rollback{datname!=\"\"}[5m])", "legendFormat": "rollback {{datname}}", "refId": "B" }
      ]
    },
    {
      "title": "Rows Operations / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "min": 0 },
        "overrides": []
      },
      "targets": [
        { "expr": "rate(pg_stat_database_tup_fetched{datname!=\"\"}[5m])", "legendFormat": "fetched {{datname}}", "refId": "A" },
        { "expr": "rate(pg_stat_database_tup_inserted{datname!=\"\"}[5m])", "legendFormat": "inserted {{datname}}", "refId": "B" },
        { "expr": "rate(pg_stat_database_tup_updated{datname!=\"\"}[5m])", "legendFormat": "updated {{datname}}", "refId": "C" },
        { "expr": "rate(pg_stat_database_tup_deleted{datname!=\"\"}[5m])", "legendFormat": "deleted {{datname}}", "refId": "D" }
      ]
    },
    {
      "title": "Locks",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "targets": [
        { "expr": "pg_locks_count", "legendFormat": "{{datname}} — {{mode}}", "refId": "A" }
      ]
    },
    {
      "title": "Connections by State",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 50 }] } },
        "overrides": []
      },
      "targets": [
        { "expr": "pg_stat_activity_count", "legendFormat": "{{state}} ({{datname}})", "refId": "A", "instant": true }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["crista", "postgresql"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "title": "🐘 PostgreSQL",
  "uid": "crista-postgresql"
}
